(library
 (name malacca)
 ; macro_parser.ml is an unfinished experiment (it needs a `Parse.expr_rule`
 ; entry point that doesn't exist). Keep it out of the build until it's ready.
 (modules :standard \ macro_parser)
 (preprocess (pps ppx_deriving.show)))

(ocamlyacc parse)
(ocamllex lex)

; The compiler's own copy of the standard headers (include/*.h), compiled into
; the library as the module Builtin_headers. See tools/embed_headers.ml.
(rule
 (targets builtin_headers.ml)
 (deps
  (glob_files ../include/*.h))
 (action
  (with-stdout-to
   builtin_headers.ml
   (run ../tools/embed_headers.exe %{deps}))))
